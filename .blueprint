created:
    - database/factories/CategoriesFactory.php
    - database/factories/ProductFactory.php
    - database/factories/ProductVariantFactory.php
    - database/factories/VariantOptionFactory.php
    - database/factories/VariantValueFactory.php
    - database/factories/OrderFactory.php
    - database/factories/OrderItemFactory.php
    - database/factories/PaymentFactory.php
    - database/factories/ShippingFactory.php
    - database/migrations/2025_11_08_042748_create_categories_table.php
    - database/migrations/2025_11_08_042749_create_products_table.php
    - database/migrations/2025_11_08_042750_create_product_variants_table.php
    - database/migrations/2025_11_08_042751_create_variant_options_table.php
    - database/migrations/2025_11_08_042752_create_variant_values_table.php
    - database/migrations/2025_11_08_042753_create_orders_table.php
    - database/migrations/2025_11_08_042754_create_order_items_table.php
    - database/migrations/2025_11_08_042755_create_payments_table.php
    - database/migrations/2025_11_08_042756_create_shippings_table.php
    - app/Models/Categories.php
    - app/Models/Product.php
    - app/Models/ProductVariant.php
    - app/Models/VariantOption.php
    - app/Models/VariantValue.php
    - app/Models/Order.php
    - app/Models/OrderItem.php
    - app/Models/Payment.php
    - app/Models/Shipping.php
    - database/seeders/CategoriesSeeder.php
    - database/seeders/ProductSeeder.php
    - database/seeders/UserSeeder.php
    - database/seeders/OrderSeeder.php
    - database/seeders/OrderItemSeeder.php
    - database/seeders/ProductVariantSeeder.php
    - database/seeders/VariantOptionSeeder.php
    - database/seeders/VariantValueSeeder.php
models:
    User: { name: string, email: string, email_verified_at: 'timestamp nullable', password: string, remember_token: 'string:100 nullable' }
    Categories: { name: string, relationships: { hasMany: Product } }
    Product: { name: string, category_id: 'foreignId:categories', slug: 'string unique', description: 'longtext nullable', base_price: 'decimal:12,2', rating: 'decimal:3,2 default:0', likes: 'integer default:0', stock: 'integer default:0', relationships: { hasMany: ProductVariant } }
    ProductVariant: { product_id: 'foreignId:product', sku: 'string unique', price: 'decimal:12,2 nullable', stock: 'integer default:0', image: 'string nullable', relationships: { hasMany: VariantValue } }
    VariantOption: { name: string, relationships: { hasMany: VariantValue } }
    VariantValue: { product_variant_id: 'id foreign', variant_option_id: 'id foreign', value: string }
    Order: { user_id: 'foreignId:user', total: integer, status: 'enum:pending,paid,shipped,delivered,canceled default:pending', payment_status: 'enum:unpaid,paid', shipping_status: 'enum:pending,shipped,delivered,canceled default:pending', relationships: { hasMany: OrderItem, belongsTo: 'user, shipping, payment' } }
    OrderItem: { order_id: 'foreignId:order', product_id: 'foreignId:product', quantity: integer, price: integer, variant_model: 'string default:standard', variant_color: 'string default:standard', variant_size: 'string default:standard', relationships: { belongsTo: 'order, product' } }
    Payment: { order_id: 'foreignId:order', payment_type: string, payment_code: string, payment_status: 'enum:pending,paid,failed default:pending', timestamps: timestamps, relationships: { hasMany: order } }
    Shipping: { order_id: 'foreignId:order', courier: string, service: string, cost: integer, tracking_number: string, timestamps: timestamps, relationships: { hasMany: order } }
